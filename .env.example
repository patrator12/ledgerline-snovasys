# Local demo only. Replace all values and use a secret manager for deployment.
# Keep database passwords URL-safe (letters and numbers) for the sample compose file.
APP_ENV=development
# Optional dedicated JWT signing secret; generate with `openssl rand -hex 32`.
# SESSION_SIGNING_KEY=
DB_OWNER_PASSWORD=replace-with-a-long-random-owner-password
LEDGERLINE_APP_PASSWORD=replace-with-a-different-long-random-app-password
TEST_DB_PASSWORD=replace-with-a-long-random-test-database-password
SEED_ADMIN_PASSWORD=choose-a-long-demo-admin-password
SEED_HOLDER_PASSWORD=choose-a-long-demo-holder-password
SEED_AUDITOR_PASSWORD=choose-a-long-demo-auditor-password
